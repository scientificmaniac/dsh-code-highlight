{
  "name": "dsh-code-highlight",
  "version": "1.1.0",
  "description": "Syntax-highlighted code for reports: Markdown/HTML fragments, Word- and PowerPoint-ready SVG, a matched PNG raster, LaTeX listings and PDF.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "syntax-highlighting",
    "code-highlighting",
    "report",
    "markdown",
    "html",
    "svg",
    "png",
    "latex",
    "docx",
    "pptx"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scientificmaniac/dsh-code-highlight.git"
  },
  "bugs": {
    "url": "https://github.com/scientificmaniac/dsh-code-highlight/issues"
  },
  "homepage": "https://github.com/scientificmaniac/dsh-code-highlight#readme",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "src",
    "py",
    "locale",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node tests/encoding.mjs && node tests/smoke.mjs",
    "test:encoding": "node tests/encoding.mjs",
    "test:raster": "node tests/rasterize.mjs",
    "example:figure": "node scripts/make-doc-figure.mjs"
  },
  "icon": "./icon.svg",
  "meta": {
    "title": "报告代码高亮",
    "description": "把代码片段渲染成 Markdown/HTML、Word/PPT 插图、LaTeX 与 PDF 可用的语法高亮产物，支持 68 种语言与 15 套配色。"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
