{
  "name": "dsh-code-highlight",
  "version": "1.0.0",
  "description": "Syntax-highlighted code for reports: Markdown/HTML fragments, Word- and PowerPoint-ready SVG, a matched PNG raster, LaTeX listings and PDF.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "syntax-highlighting",
    "code-highlighting",
    "report",
    "markdown",
    "html",
    "svg",
    "png",
    "latex",
    "docx",
    "pptx"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scientificmaniac/dsh-code-highlight.git"
  },
  "bugs": {
    "url": "https://github.com/scientificmaniac/dsh-code-highlight/issues"
  },
  "homepage": "https://github.com/scientificmaniac/dsh-code-highlight#readme",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "src",
    "py",
    "locale",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node tests/smoke.mjs",
